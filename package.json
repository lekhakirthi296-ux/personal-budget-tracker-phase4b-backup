{
  "name": "personal-budget-tracker",
  "version": "1.0.0",
  "description": "Personal Budget Tracker App - Phase 1 Foundation",
  "main": "server/server.js",
  "scripts": {
    "start": "NODE_ENV=production node server/server.js",
    "build": "npm --prefix client run build",
    "server": "SERVER_PORT=5000 node server/server.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "node server/tests/phase4_budgets.test.js && node server/tests/e2e_budgets.test.js",
    "install-all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "keywords": [
    "budget",
    "finance",
    "tracker",
    "expense-tracker",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "server",
    "client"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
